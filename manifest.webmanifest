{
  "name": "Checklist OMNI",
  "short_name": "Checklist OMNI",
  "description": "PWA offline com o caderno unificado de checklists normais da frota OMNI: marcação de itens, progresso por perna e retomada após interrupção.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#070b10",
  "theme_color": "#070b10",
  "icons": [
    {
      "src": "./assets/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
